# Máquina dedicada: Caddy publica 80/443 y pide el certificado.
# En el servidor compartido no uses este archivo; ahí manda Caddyfile.server (HTTP 8090).
{$DOMAIN}, www.{$DOMAIN} {
	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	encode zstd gzip

	handle_path /media/* {
		root * /srv/media/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /api/* {
		reverse_proxy {
			dynamic a api 8000 {
				refresh 10s
				resolvers 127.0.0.11
			}
		}
	}

	handle {
		reverse_proxy {
			dynamic a web 3010 {
				refresh 10s
				resolvers 127.0.0.11
			}
		}
	}

	redir /aviso-de-privacidad.html /aviso-de-privacidad permanent

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://open.spotify.com https://embed-cdn.spotifycdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://open.spotify.com https://www.youtube-nocookie.com https://w.soundcloud.com https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		-Server
	}

	request_body {
		max_size 210MB
	}
}

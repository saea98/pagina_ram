# Desarrollo. El sitio de producción (dominio, HSTS, redirección www) se aplica en T-25.
localhost {
	tls internal

	encode zstd gzip

	handle_path /media/* {
		root * /srv/media/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /api/* {
		reverse_proxy {
			dynamic a api 8000 {
				refresh 10s
				resolvers 127.0.0.11
			}
		}
	}

	handle {
		reverse_proxy {
			dynamic a web 3010 {
				refresh 10s
				resolvers 127.0.0.11
			}
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	request_body {
		max_size 210MB
	}
}

:8025 {
	reverse_proxy mailpit:8025
}
